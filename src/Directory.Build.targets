<Project>

  <!-- MSBuildWorkspace starts BuildHost-*/ as a separate process, so it must stay loose files next to a single-file exe. -->
  <Target Name="KeepRoslynBuildHostOutOfBundle" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('BuildHost-'))"
                             ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

</Project>
